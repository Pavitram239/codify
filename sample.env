# Application
PORT=10000
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/database
JWT_SECRET_KEY=replace-with-a-strong-random-secret
JWT_EXP=1d
SENDGRID_API_KEY=replace-with-sendgrid-api-key
ALL_IP=0.0.0.0
BACKEND_ORIGIN=https://your-frontend.onrender.com
VITE_FRONTEND_ORIGIN=https://your-backend.onrender.com/api/v1
GEMINI_API_KEY=your-gemini-api-key

# Docker/local services
DOCKER_MONGO_URI=mongodb://mongo:27017/coding-platform
JUDGE0_BASE_URL=http://judge0-server:2358
JUDGE0_TOKEN=replace-with-judge0-auth-token
RABBITMQ_URL=amqp://judge0:replace-with-rabbitmq-password@rabbitmq:5672

# Admin bootstrap, only needed when running the create-admin command
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-secure-admin-password
